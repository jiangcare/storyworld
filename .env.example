# ===== Telegram =====
# 在 @BotFather 创建机器人后获取 token
TELEGRAM_BOT_TOKEN=

# ===== DeepSeek AI =====
# DeepSeek 开放平台 API Key: https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 默认使用 v4 flash；若你的账号不支持该模型名，改为 deepseek-chat
DEEPSEEK_MODEL=deepseek-v4-flash

# ===== 本地存储（首次启动自动建库，不需要数据库服务）=====
# 相对路径以项目根目录为基准；绝对路径示例 sqlite:////home/me/storyworld.db
DATABASE_URL=sqlite:///data/storyworld.db

# ===== 后台管理 =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ===== 游戏节奏 =====
# 默认每日剧情推送时间（24小时制）
PUSH_HOUR=20
PUSH_MINUTE=0
# 每个玩家每天行动点数上限
MAX_ACTION_POINTS=3
# tick 扫描间隔（秒）
TICK_SCAN_SECONDS=60
