# ===== Telegram =====
# 在 @BotFather 创建机器人后获取 token
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# ===== DeepSeek AI =====
# DeepSeek 开放平台 API Key: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 默认使用 v4 flash；若你的账号不支持该模型名，改为 deepseek-chat
DEEPSEEK_MODEL=deepseek-v4-flash

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=storyworld
MYSQL_PASSWORD=storyworld123
MYSQL_DB=storyworld

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===== 后台管理 =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ===== 游戏节奏 =====
# 默认每日剧情推送时间（24小时制）
PUSH_HOUR=20
PUSH_MINUTE=0
# 每个玩家每天行动点数上限
MAX_ACTION_POINTS=3
# tick 扫描间隔（秒）
TICK_SCAN_SECONDS=60
